SECRET_KEY=replace-with-a-long-random-value
DATABASE_URL=sqlite:///app.db

MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_USE_TLS=true
MAIL_DEFAULT_SENDER=your-email@gmail.com
# These SMTP values are fallback defaults. Administrators can import and manage
# them later from the Integrations page.
APP_BASE_URL=http://127.0.0.1:5000
DEFAULT_CURRENCY=MYR
AUTO_GENERATE_BILLS=false
PAYMENT_PROVIDER=manual
PAYMENT_PROOF_MAX_MB=5

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

FLASK_DEBUG=false
SESSION_COOKIE_SECURE=false
GUNICORN_WORKERS=2
# Operational estimate shown in the admin dashboard, not a hardware guarantee.
MAX_CONCURRENT_USERS=100
ACTIVITY_HEARTBEAT_SECONDS=30
